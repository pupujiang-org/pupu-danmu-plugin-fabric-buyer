{
  "schema_version": 2,
  "id": "org.pupujiang.fabric-buyer",
  "name": "布料买家 Worker",
  "version": "1.0.0-dev.1",
  "description": "布料直播场景的开发期 Python Worker。",
  "author": "pupujiang",
  "license": "MIT",
  "min_host_version": "0.5.0b3",
  "kind": "ai-participation",
  "runtime_type": "python-worker",
  "plugin_api_version": 2,
  "capabilities": [
    "chat.read",
    "room.read",
    "llm.generate",
    "session.config.read"
  ],
  "config_schema": {
    "persona": {
      "type": "select",
      "label": "观众角色",
      "description": "仅在当前会话中使用。",
      "required": true,
      "options": ["maker", "buyer"],
      "default": "maker"
    },
    "allow_initiative": {
      "type": "checkbox",
      "label": "允许主动开启话题",
      "default": true
    }
  },
  "recommended_pacing": {
    "min_interval_seconds": 90,
    "max_interval_seconds": 300,
    "hourly_limit": 20
  },
  "resources": {},
  "entrypoint": "fabric_buyer.entrypoint:run"
}
